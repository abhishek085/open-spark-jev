# ollama.com/abhishek085/spark-s1:4b-v8  (built from the Q8_0 GGUF; see ../README.md)
# Decision model, not a chat model: send the fully rendered prompt with "raw": true and read top_logprobs of the
# first token. The answer is softmax(logprob / 2.5) over the option letters (calibrated choice temperature).
FROM ../../../gguf_out/spark-s1-4b-v8-Q8_0.gguf
TEMPLATE "{{ .Prompt }}"
PARAMETER num_ctx 16384
PARAMETER num_predict 1
PARAMETER temperature 0
